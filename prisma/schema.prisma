generator client {
  provider = "prisma-client-js"
  output   = "../web/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum EstadoPedido {
  NOVO
  EM_PREPARACAO
  PRONTO
  EM_ENTREGA
  CONCLUIDO
  CANCELADO
}

enum TipoEntrega {
  DELIVERY
  RETIRADA_BALCAO
  SALAO_MESA
}

enum EstadoPagamento {
  PENDENTE
  PAGO
  RECUSADO
}

enum MetodoPagamento {
  PIX_ONLINE
  CARTAO_ENTREGA
  DINHEIRO_ENTREGA
}

enum PapelUsuario {
  SUPER_ADMIN
  LOJISTA
}

enum TemplateCardapio {
  CLASSICO
  MODERNO
  DARK
}

enum TexturaFundo {
  NENHUMA
  GRAIN
  DOTS
  WAVES
  STRIPES
  CHECKS
  CIRCLES
  FOOD
}

enum DestinoPreparo {
  COZINHA
  BAR
  NENHUM
}

enum TipoDesconto {
  PERCENTUAL
  VALOR_FIXO
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  AJUSTE
  VENDA
  CANCELAMENTO
}

enum StatusTicket {
  ABERTO
  RESPONDIDO
  FECHADO
}

model Loja {
  id               String           @id @default(uuid()) @db.Uuid
  nome             String
  slug             String           @unique
  telefoneWhatsapp String           @map("telefone_whatsapp")
  corPrimaria      String           @map("cor_primaria")
  exigirCadastro   Boolean          @default(false) @map("exigir_cadastro")
  ativa            Boolean          @default(true)
  templateCardapio TemplateCardapio @default(CLASSICO) @map("template_cardapio")
  paletaPreset          String?          @map("paleta_preset")
  texturaFundo          TexturaFundo     @default(NENHUMA) @map("textura_fundo")
  logoUrl               String?          @map("logo_url")
  fontePreset           String?          @map("fonte_preset")
  subtituloCardapio     String?          @map("subtitulo_cardapio")
  tituloAba             String?          @map("titulo_aba")
  aceitaPixSite         Boolean          @default(true) @map("aceita_pix_site")
  aceitaCartaoEntrega   Boolean          @default(true) @map("aceita_cartao_entrega")
  aceitaDinheiroEntrega Boolean          @default(true) @map("aceita_dinheiro_entrega")
  pagamentoNoSite       Boolean          @default(true) @map("pagamento_no_site")
  pagamentoNaMesa       Boolean          @default(true) @map("pagamento_na_mesa")
  timezone              String           @default("America/Sao_Paulo")
  pedidoMinimo          Decimal?         @db.Decimal(10, 2) @map("pedido_minimo")
  taxaEntregaFixa       Decimal?         @db.Decimal(10, 2) @map("taxa_entrega_fixa")
  freteGratisAcima      Decimal?         @db.Decimal(10, 2) @map("frete_gratis_acima")
  pdvAtivo              Boolean   @default(true) @map("pdv_ativo")
  onboardingDismissedEm DateTime?              @map("onboarding_dismissed_em")
  trialExpiraEm         DateTime?              @map("trial_expira_em")
  planoInteresse        String?                @map("plano_interesse")
  recuperadorAtivo      Boolean   @default(true) @map("recuperador_ativo")
  recuperadorMinutos    Int       @default(15)   @map("recuperador_minutos")
  ifoodEntregaFacilAtivo Boolean  @default(false) @map("ifood_entrega_facil_ativo")
  ifoodMerchantId       String?                  @map("ifood_merchant_id")
  ifoodAccessToken      String?   @db.Text        @map("ifood_access_token")
  ifoodRefreshToken     String?   @db.Text        @map("ifood_refresh_token")
  ifoodTokenExpiraEm    DateTime?                 @map("ifood_token_expira_em")
  criadoEm              DateTime  @default(now()) @map("criado_em")

  categorias           Categoria[]
  produtos             Produto[]
  pedidos              Pedido[]
  usuarios             Usuario[]
  mesas                Mesa[]
  funcionarios         Funcionario[]
  adicionais           Adicional[]
  horarios             HorarioFuncionamento[]
  cupons               Cupom[]
  tickets              TicketSuporte[]
  movimentacoesEstoque MovimentacaoEstoque[]
  carrinhosAbandonados CarrinhoAbandonado[]

  @@map("lojas")
}

model CarrinhoAbandonado {
  id                   String    @id @default(uuid()) @db.Uuid
  lojaId               String    @db.Uuid @map("loja_id")
  telefone             String?
  nomeCliente          String?   @map("nome_cliente")
  itensJson            Json      @map("itens_json")
  subtotal             Decimal   @db.Decimal(10, 2)
  recuperacaoEnviadaEm DateTime? @map("recuperacao_enviada_em")
  recuperadoEm         DateTime? @map("recuperado_em")
  pedidoRecuperadoId   String?   @unique @db.Uuid @map("pedido_recuperado_id")
  criadoEm             DateTime  @default(now()) @map("criado_em")
  atualizadoEm         DateTime  @updatedAt @map("atualizado_em")

  loja             Loja    @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  pedidoRecuperado Pedido? @relation("PedidoRecuperado", fields: [pedidoRecuperadoId], references: [id], onDelete: SetNull)

  @@unique([lojaId, telefone], name: "lojaId_telefone")
  @@index([lojaId, criadoEm])
  @@map("carrinhos_abandonados")
}

model HorarioFuncionamento {
  id        String  @id @default(uuid()) @db.Uuid
  lojaId    String  @db.Uuid @map("loja_id")
  diaSemana Int     @map("dia_semana")
  abreAs    String  @map("abre_as")
  fechaAs   String  @map("fecha_as")
  fechado   Boolean @default(false)

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@unique([lojaId, diaSemana])
  @@index([lojaId])
  @@map("horarios_funcionamento")
}

model Cliente {
  id        String     @id @default(uuid()) @db.Uuid
  telefone  String     @unique
  nome      String?
  criadoEm  DateTime   @default(now()) @map("criado_em")

  enderecos Endereco[]
  pedidos   Pedido[]

  @@map("clientes")
}

model Endereco {
  id              String   @id @default(uuid()) @db.Uuid
  clienteId       String   @db.Uuid @map("cliente_id")
  rua             String
  numero          String
  bairro          String
  cidade          String
  pontoReferencia String?  @map("ponto_referencia")

  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pedidosEntrega  Pedido[] @relation("PedidoEnderecoEntrega")

  @@index([clienteId])
  @@map("enderecos")
}

model Categoria {
  id       String    @id @default(uuid()) @db.Uuid
  lojaId   String    @db.Uuid @map("loja_id")
  nome     String
  ordem    Int       @default(0)

  loja     Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  produtos Produto[]

  @@index([lojaId])
  @@map("categorias")
}

model Produto {
  id             String         @id @default(uuid()) @db.Uuid
  lojaId         String         @db.Uuid @map("loja_id")
  categoriaId    String         @db.Uuid @map("categoria_id")
  nome           String
  descricao      String         @db.Text
  preco          Decimal        @db.Decimal(10, 2)
  imagemUrl      String?        @map("imagem_url")
  disponivel        Boolean        @default(true)
  emDestaque        Boolean        @default(false) @map("em_destaque")
  destinoPreparo    DestinoPreparo @default(NENHUM) @map("destino_preparo")
  controlaEstoque   Boolean        @default(false) @map("controla_estoque")
  quantidadeEstoque Int            @default(0)     @map("quantidade_estoque")
  estoqueMinimo     Int?                           @map("estoque_minimo")

  loja          Loja               @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  categoria     Categoria          @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  itensPedido   ItemPedido[]
  adicionais    ProdutoAdicional[]
  movimentacoes MovimentacaoEstoque[]

  @@index([lojaId])
  @@index([categoriaId])
  @@map("produtos")
}

model Mesa {
  id         String   @id @default(uuid()) @db.Uuid
  lojaId     String   @db.Uuid @map("loja_id")
  numero     String
  nome       String?
  ativa      Boolean  @default(true)
  capacidade Int?
  criadoEm   DateTime @default(now()) @map("criado_em")

  loja    Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@unique([lojaId, numero])
  @@index([lojaId])
  @@map("mesas")
}

model Funcionario {
  id        String   @id @default(uuid()) @db.Uuid
  lojaId    String   @db.Uuid @map("loja_id")
  nome      String
  pin       String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  loja    Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@index([lojaId])
  @@map("funcionarios")
}

model Pedido {
  id                 String          @id @default(uuid()) @db.Uuid
  lojaId             String          @db.Uuid @map("loja_id")
  clienteId          String?         @db.Uuid @map("cliente_id")
  estadoPedido       EstadoPedido    @map("estado_pedido")
  tipoEntrega        TipoEntrega     @map("tipo_entrega")
  enderecoEntregaId  String?         @db.Uuid @map("endereco_entrega_id")
  subtotal           Decimal?        @db.Decimal(10, 2)
  taxaEntrega        Decimal?        @db.Decimal(10, 2) @map("taxa_entrega")
  desconto           Decimal?        @db.Decimal(10, 2)
  cupomId            String?         @db.Uuid @map("cupom_id")
  total              Decimal         @db.Decimal(10, 2)
  estadoPagamento    EstadoPagamento @map("estado_pagamento")
  metodoPagamento    MetodoPagamento @map("metodo_pagamento")
  idPagamentoGateway String?         @map("id_pagamento_gateway")
  nomeCliente        String?         @map("nome_cliente")
  observacoes        String?         @db.Text
  mesaId             String?         @db.Uuid @map("mesa_id")
  funcionarioId      String?         @db.Uuid @map("funcionario_id")
  criadoEm           DateTime        @default(now()) @map("criado_em")

  entregueBarEm  DateTime?       @map("entregue_bar_em")

  ifoodEntregaId           String?   @map("ifood_entrega_id")
  ifoodEntregaStatus       String?   @map("ifood_entrega_status")
  ifoodEntregaSolicitadaEm DateTime? @map("ifood_entrega_solicitada_em")

  loja                 Loja         @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  cliente              Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  enderecoEntrega      Endereco?    @relation("PedidoEnderecoEntrega", fields: [enderecoEntregaId], references: [id], onDelete: SetNull)
  mesa                 Mesa?        @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  funcionario          Funcionario? @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)
  cupom                Cupom?       @relation(fields: [cupomId], references: [id], onDelete: SetNull)
  itens                ItemPedido[]
  movimentacoesEstoque MovimentacaoEstoque[]
  carrinhoRecuperado   CarrinhoAbandonado? @relation("PedidoRecuperado")

  @@index([lojaId])
  @@index([clienteId])
  @@index([enderecoEntregaId])
  @@index([mesaId])
  @@index([funcionarioId])
  @@index([cupomId])
  @@map("pedidos")
}

model ItemPedido {
  id            String  @id @default(uuid()) @db.Uuid
  pedidoId      String  @db.Uuid @map("pedido_id")
  produtoId     String  @db.Uuid @map("produto_id")
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2) @map("preco_unitario")
  observacao    String? @db.Text

  pedido     Pedido                @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto    Produto               @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  adicionais ItemPedidoAdicional[]

  @@index([pedidoId])
  @@index([produtoId])
  @@map("itens_pedido")
}

model Usuario {
  id        String       @id @default(uuid()) @db.Uuid
  email     String       @unique
  senhaHash String       @map("senha_hash")
  nome      String
  papel     PapelUsuario
  lojaId    String?      @db.Uuid @map("loja_id")
  ativo     Boolean      @default(true)
  criadoEm  DateTime     @default(now()) @map("criado_em")

  loja    Loja?          @relation(fields: [lojaId], references: [id], onDelete: SetNull)
  tickets TicketSuporte[]

  @@index([lojaId])
  @@map("usuarios")
}

model Adicional {
  id         String   @id @default(uuid()) @db.Uuid
  lojaId     String   @db.Uuid @map("loja_id")
  nome       String
  preco      Decimal  @db.Decimal(10, 2)
  disponivel Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  loja     Loja               @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  produtos ProdutoAdicional[]
  itens    ItemPedidoAdicional[]

  @@index([lojaId])
  @@map("adicionais")
}

model ProdutoAdicional {
  produtoId   String @db.Uuid @map("produto_id")
  adicionalId String @db.Uuid @map("adicional_id")

  produto   Produto   @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  adicional Adicional @relation(fields: [adicionalId], references: [id], onDelete: Cascade)

  @@id([produtoId, adicionalId])
  @@index([produtoId])
  @@index([adicionalId])
  @@map("produtos_adicionais")
}

model ItemPedidoAdicional {
  id           String  @id @default(uuid()) @db.Uuid
  itemPedidoId String  @db.Uuid @map("item_pedido_id")
  adicionalId  String  @db.Uuid @map("adicional_id")
  preco        Decimal @db.Decimal(10, 2)
  quantidade   Int     @default(1)

  itemPedido ItemPedido @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)
  adicional  Adicional  @relation(fields: [adicionalId], references: [id], onDelete: Restrict)

  @@index([itemPedidoId])
  @@index([adicionalId])
  @@map("itens_pedido_adicionais")
}

model Cupom {
  id           String       @id @default(uuid()) @db.Uuid
  lojaId       String       @db.Uuid @map("loja_id")
  codigo       String
  tipo         TipoDesconto
  valor        Decimal      @db.Decimal(10, 2)
  pedidoMinimo Decimal?     @db.Decimal(10, 2) @map("pedido_minimo")
  maxUsos      Int?         @map("max_usos")
  usosAtuais   Int          @default(0) @map("usos_atuais")
  validoDe     DateTime?    @map("valido_de")
  validoAte    DateTime?    @map("valido_ate")
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now()) @map("criado_em")

  loja    Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  pedidos Pedido[]

  @@unique([lojaId, codigo])
  @@index([lojaId])
  @@map("cupons")
}

model MovimentacaoEstoque {
  id                 String                  @id @default(uuid()) @db.Uuid
  lojaId             String                  @db.Uuid @map("loja_id")
  produtoId          String                  @db.Uuid @map("produto_id")
  tipo               TipoMovimentacaoEstoque
  quantidade         Int
  quantidadeAnterior Int                     @map("quantidade_anterior")
  quantidadeNova     Int                     @map("quantidade_nova")
  observacao         String?                 @db.Text
  pedidoId           String?                 @db.Uuid @map("pedido_id")
  criadoEm           DateTime                @default(now()) @map("criado_em")

  loja    Loja    @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  pedido  Pedido? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  @@index([lojaId])
  @@index([produtoId])
  @@index([pedidoId])
  @@map("movimentacoes_estoque")
}

model TicketSuporte {
  id        String       @id @default(uuid()) @db.Uuid
  lojaId    String?      @db.Uuid @map("loja_id")
  usuarioId String?      @db.Uuid @map("usuario_id")
  assunto   String
  mensagem  String       @db.Text
  status    StatusTicket @default(ABERTO)
  criadoEm  DateTime     @default(now()) @map("criado_em")

  loja    Loja?    @relation(fields: [lojaId], references: [id], onDelete: SetNull)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([lojaId])
  @@index([usuarioId])
  @@map("tickets_suporte")
}
