# ─── URL da aplicação ────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ─── Banco de dados ───────────────────────────────────────────────────────────
# PostgreSQL (local Docker, Neon, Supabase, Railway…)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lookmenu?schema=public"

# ─── Autenticação JWT ─────────────────────────────────────────────────────────
# Gere um valor aleatório longo: openssl rand -base64 48
AUTH_SECRET="dev-secret-change-in-production"

# ─── Credenciais de seed ──────────────────────────────────────────────────────
# Super admin inicial (usado pelo prisma/seed.ts)
SUPER_ADMIN_EMAIL="admin@lookmenu.local"
SUPER_ADMIN_PASSWORD="admin123"

# Lojista demo vinculado ao burger-king-demo
LOJISTA_DEMO_EMAIL="lojista@burger-king-demo.local"
LOJISTA_DEMO_PASSWORD="lojista123"

# ─── WhatsApp — Evolution API ─────────────────────────────────────────────────
# Ative para enviar mensagens automáticas (requer docker-compose up -d)
WHATSAPP_ENABLED="false"

# URL da Evolution API (padrão local com docker-compose)
EVOLUTION_API_URL="http://localhost:8080"

# Chave de autenticação da Evolution API (defina em docker-compose.yml também)
EVOLUTION_API_KEY="change-this-evolution-key"

# Nome da instância WhatsApp criada na Evolution API
EVOLUTION_INSTANCE="lookmenu"

# ─── Storage de imagens ───────────────────────────────────────────────────────
# "local" salva em public/uploads/ | "supabase" usa Supabase Storage
STORAGE_PROVIDER="local"

# Necessário apenas se STORAGE_PROVIDER=supabase
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_KEY="eyJ..."
SUPABASE_BUCKET="lookmenu"
