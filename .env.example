# ─── URL da aplicação ────────────────────────────────────────────────────────

# Local: http://localhost:3000

# Render: https://seu-app.onrender.com (copie após o deploy)

APP_URL="http://localhost:3000"



# ─── Banco de dados (Supabase PostgreSQL) ─────────────────────────────────────

# Runtime — use o pooler "Transaction" (porta 6543) em produção:

# DATABASE_URL="postgresql://postgres.[ref]:[SENHA]@aws-0-[regiao].pooler.supabase.com:6543/postgres?pgbouncer=true"

#

# Migrations/db push — conexão direta (porta 5432):

# DIRECT_URL="postgresql://postgres.[ref]:[SENHA]@aws-0-[regiao].pooler.supabase.com:5432/postgres"

#

# Local (Docker):

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lookmenu?schema=public"



# Opcional em local; obrigatório no Render com Supabase pooler

# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lookmenu?schema=public"



# ─── Autenticação JWT ─────────────────────────────────────────────────────────

# Gere com: powershell scripts/generate-secrets.ps1

AUTH_SECRET="dev-secret-change-in-production"



# ─── Cron (recuperador de carrinho) ───────────────────────────────────────────

# Protege POST /api/cron/recuperador — gere com generate-secrets.ps1

CRON_SECRET="dev-cron-secret-change-in-production"



# ─── Credenciais de seed ──────────────────────────────────────────────────────

SUPER_ADMIN_EMAIL="admin@lookmenu.local"

SUPER_ADMIN_PASSWORD="admin123"

LOJISTA_DEMO_EMAIL="lojista@burger-king-demo.local"

LOJISTA_DEMO_PASSWORD="lojista123"



# ─── WhatsApp — Evolution API (opcional, local) ───────────────────────────────

# No Render gratuito deixe false — Evolution precisa de Docker/VPS

WHATSAPP_ENABLED="false"

EVOLUTION_API_URL="http://localhost:8080"

EVOLUTION_API_KEY="change-this-evolution-key"

EVOLUTION_INSTANCE="lookmenu"



# ─── Suporte ao lojista ───────────────────────────────────────────────────────

SUPPORT_WHATSAPP="5511999999999"



# ─── iFood Entrega Fácil (API de Shipping) ────────────────────────────────────

# Credenciais OAuth2 (client_credentials) do Portal do Desenvolvedor iFood.

# Sem elas a integração aparece como "desconectada" no painel (não quebra o app).

IFOOD_CLIENT_ID=""

IFOOD_CLIENT_SECRET=""

# Base da Merchant API (padrão de produção; geralmente não precisa alterar)

IFOOD_API_URL="https://merchant-api.ifood.com.br"

# Segredo para validar POST /api/webhooks/ifood/entrega

IFOOD_WEBHOOK_SECRET="dev-ifood-webhook-secret-change-in-production"



# ─── Storage de imagens ───────────────────────────────────────────────────────

# Local: "local" | Render/produção: "supabase" (disco efêmero no Render)

STORAGE_PROVIDER="local"



# Obrigatório se STORAGE_PROVIDER=supabase

SUPABASE_URL="https://xxxx.supabase.co"

SUPABASE_SERVICE_KEY="eyJ..."

SUPABASE_BUCKET="lookmenu"

